model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Crimes","Predictions","ModelComparison","FeatureImportance","ConfusionMatrices","DataFolder"]

annotation PBI_ProTooling = ["DevMode"]

ref table Crimes
ref table Predictions
ref table ModelComparison
ref table FeatureImportance
ref table ConfusionMatrices

