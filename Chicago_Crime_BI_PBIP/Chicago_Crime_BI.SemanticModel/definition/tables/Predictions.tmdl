table Predictions
	lineageTag: 5279311b-b19e-4b8c-8c0e-e0d812bb1dc3

	measure 'BA Incidents' = COUNTROWS(Predictions)
		formatString: #,0
		lineageTag: a467a420-b8e4-4cc9-baf1-b7b3e499d4f0

	measure 'BA Arrests' = CALCULATE(COUNTROWS(Predictions), Predictions[Actual_Arrest] = 1)
		formatString: #,0
		lineageTag: 45890166-8f18-4881-a9eb-9b29049909b0

	measure 'BA Arrest Rate' = DIVIDE([BA Arrests], [BA Incidents])
		formatString: 0.0%
		lineageTag: ebba3797-020b-444d-86cd-91bf263ac2e0

	measure 'Predicted Arrest Rate' = DIVIDE(CALCULATE(COUNTROWS(Predictions), Predictions[Predicted_Arrest] = 1), [BA Incidents])
		formatString: 0.0%
		lineageTag: 0f243f81-df88-48c4-ae75-dbf36dbf3093

	measure 'Avg Arrest Probability' = AVERAGE(Predictions[Arrest_Probability])
		formatString: 0.0%
		lineageTag: a872ce5c-79ab-4369-87b6-0b67d8e1767d

	measure 'Avg Latitude' = AVERAGE(Predictions[Latitude])
		formatString: 0.0000
		lineageTag: d416f509-d857-49d1-a106-89caf921182e

	measure 'Avg Longitude' = AVERAGE(Predictions[Longitude])
		formatString: 0.0000
		lineageTag: 6b8b1346-88b2-430b-98c1-798c0a7c1cc0

	measure 'Test Accuracy' = CALCULATE(AVERAGE(Predictions[Correct]), Predictions[Split] = "Test")
		formatString: 0.0%
		lineageTag: 616faf79-67bb-4412-85f1-6b54e5c7382e

	measure 'Train Accuracy' = CALCULATE(AVERAGE(Predictions[Correct]), Predictions[Split] = "Train")
		formatString: 0.0%
		lineageTag: 08f42809-db73-4354-921c-8ae7d0c8bd05

	measure 'Test TP' = CALCULATE(COUNTROWS(Predictions), Predictions[Split] = "Test", Predictions[Outcome] = "True Positive")
		formatString: #,0
		lineageTag: 96b1f762-83be-4dfa-af1f-e88c7f4b2029

	measure 'Test FP' = CALCULATE(COUNTROWS(Predictions), Predictions[Split] = "Test", Predictions[Outcome] = "False Positive")
		formatString: #,0
		lineageTag: 1e4a7678-9831-4444-a0e9-7582563c3426

	measure 'Test FN' = CALCULATE(COUNTROWS(Predictions), Predictions[Split] = "Test", Predictions[Outcome] = "False Negative")
		formatString: #,0
		lineageTag: 71680cb4-dbe7-486d-8951-d8a7335e055a

	measure 'Test Precision (Arrest)' = DIVIDE([Test TP], [Test TP] + [Test FP])
		formatString: 0.0%
		lineageTag: 0c1298a9-e71b-44e1-a522-2f6e474aa67d

	measure 'Test Recall (Arrest)' = DIVIDE([Test TP], [Test TP] + [Test FN])
		formatString: 0.0%
		lineageTag: da623b8a-9c79-4d84-b722-4b05bac9a210

	measure 'Test Incidents' = CALCULATE(COUNTROWS(Predictions), Predictions[Split] = "Test")
		formatString: #,0
		lineageTag: a61d3561-bd85-40bb-9d87-515e1de1c6c7

