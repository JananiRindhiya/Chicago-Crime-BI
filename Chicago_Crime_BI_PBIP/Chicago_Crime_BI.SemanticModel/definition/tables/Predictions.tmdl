	partition Predictions = m
		mode: import
		source =
				let
					Folder = Text.TrimEnd(Text.Replace(Text.Trim(DataFolder), """", ""), "\"),
					Source = Csv.Document(File.Contents(Folder & "\crime_predictions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"ID", "Primary Type", "DescGroup", "District", "Beat", "Community Area", "Latitude", "Longitude", "Hour", "DayOfWeek", "Timeframe", "Domestic", "Actual_Arrest", "Predicted_Arrest", "Arrest_Probability", "Correct", "Split", "Model", "Date"}),
					Typed = Table.TransformColumnTypes(Selected, {{"ID", Int64.Type}, {"Primary Type", type text}, {"DescGroup", type text}, {"District", Int64.Type}, {"Beat", Int64.Type}, {"Community Area", Int64.Type}, {"Latitude", type number}, {"Longitude", type number}, {"Hour", Int64.Type}, {"DayOfWeek", type text}, {"Timeframe", type text}, {"Domestic", Int64.Type}, {"Actual_Arrest", Int64.Type}, {"Predicted_Arrest", Int64.Type}, {"Arrest_Probability", type number}, {"Correct", Int64.Type}, {"Split", type text}, {"Model", type text}, {"Date", type datetime}}, "en-US"),
					AddOutcome = Table.AddColumn(Typed, "Outcome", each if [Actual_Arrest]=1 and [Predicted_Arrest]=1 then "True Positive" else if [Actual_Arrest]=0 and [Predicted_Arrest]=1 then "False Positive" else if [Actual_Arrest]=1 then "False Negative" else "True Negative", type text),
					AddActual = Table.AddColumn(AddOutcome, "Actual Label", each if [Actual_Arrest]=1 then "Arrest" else "No arrest", type text),
					AddPred = Table.AddColumn(AddActual, "Predicted Label", each if [Predicted_Arrest]=1 then "Arrest" else "No arrest", type text),
					AddDay = Table.AddColumn(AddPred, "DayNum", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type)
				in
					AddDay

	annotation PBI_ResultType = Table

