table ModelComparison
	lineageTag: 9f3d23e8-badd-47dc-a357-f88e8e64b1c3

	measure 'Model Accuracy' = MAX(ModelComparison[Accuracy])
		formatString: 0.0%
		lineageTag: 9e806a57-a883-4f2f-ae31-62895ba64f2d

	measure 'Balanced Accuracy' = MAX(ModelComparison[BalancedAccuracy])
		formatString: 0.0%
		lineageTag: 93aa7cc4-feb9-4880-9b5a-8535b8af8400

	measure 'Arrest F1' = MAX(ModelComparison[F1_Arrest])
		formatString: 0.000
		lineageTag: 43065948-51c2-40ab-821a-ee7bc4338c62

	measure 'Arrest Recall' = MAX(ModelComparison[Recall_Arrest])
		formatString: 0.0%
		lineageTag: 1fe60a0e-a259-4727-a3b4-44843640898b

	measure 'Arrest Precision' = MAX(ModelComparison[Precision_Arrest])
		formatString: 0.0%
		lineageTag: cf63b8c6-19e1-44aa-be22-e0e87c68b7e3

	measure 'ROC AUC' = MAX(ModelComparison[ROC_AUC])
		formatString: 0.000
		lineageTag: 83ad3bc8-39c2-47c9-8f1a-34a5ba8ed592

	measure 'Best Baseline Accuracy' = CALCULATE(MAX(ModelComparison[Accuracy]), REMOVEFILTERS(ModelComparison), ModelComparison[Group] = "Baseline (paper)", ModelComparison[Training] = "SMOTE")
		formatString: 0.0%
		lineageTag: af3c48b7-b5bc-4a84-97da-c9fd228b7e47

	measure 'Best Ensemble Accuracy' = CALCULATE(MAX(ModelComparison[Accuracy]), REMOVEFILTERS(ModelComparison), ModelComparison[Group] = "Proposed ensemble", ModelComparison[Training] = "SMOTE")
		formatString: 0.0%
		lineageTag: ed34d547-2a2a-418e-913f-42f5ca88e100

	measure 'Best Baseline Balanced Accuracy' = CALCULATE(MAX(ModelComparison[BalancedAccuracy]), REMOVEFILTERS(ModelComparison), ModelComparison[Group] = "Baseline (paper)", ModelComparison[Training] = "SMOTE")
		formatString: 0.0%
		lineageTag: 4736562e-6528-42eb-bbfc-6d31aadc7593

	measure 'Best Ensemble Balanced Accuracy' = CALCULATE(MAX(ModelComparison[BalancedAccuracy]), REMOVEFILTERS(ModelComparison), ModelComparison[Group] = "Proposed ensemble", ModelComparison[Training] = "SMOTE")
		formatString: 0.0%
		lineageTag: e435bbb3-9815-4fac-8c7c-5fc8835f942f

	measure 'Accuracy Gain (pp)' = ([Best Ensemble Accuracy] - [Best Baseline Accuracy]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: f79241be-e0af-4dc4-8b5c-8f1c1f30b83d

	measure 'Balanced Accuracy Gain (pp)' = ([Best Ensemble Balanced Accuracy] - [Best Baseline Balanced Accuracy]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: 2ef9aabe-4caa-425b-adb0-8add1c380efb

	measure 'Accuracy Diff vs Best Baseline (pp)' = ([Model Accuracy] - [Best Baseline Accuracy]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: 8a6e094a-134f-4a51-b00a-9e18e392a8b7

	measure 'Balanced Acc Diff vs Best Baseline (pp)' = ([Balanced Accuracy] - [Best Baseline Balanced Accuracy]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: 7a45e97e-70b0-40d3-a99d-70d233cf4014

