	column DayNum
		dataType: int64
		formatString: 0
		lineageTag: c328de7a-d190-4c3f-be2f-b164215682da
		summarizeBy: none
		sourceColumn: DayNum

	partition Crimes = m
		mode: import
		source =
				let
					Folder = Text.TrimEnd(Text.Replace(Text.Trim(DataFolder), """", ""), "\"),
					Source = Csv.Document(File.Contents(Folder & "\crime_cleaned.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"ID", "Primary Type", "DescGroup", "Arrest", "Domestic", "Beat", "District", "Community Area", "Latitude", "Longitude", "Hour", "Month", "DayOfWeek", "Timeframe", "YearMonth", "Date"}),
					Typed = Table.TransformColumnTypes(Selected, {{"ID", Int64.Type}, {"Primary Type", type text}, {"DescGroup", type text}, {"Arrest", Int64.Type}, {"Domestic", Int64.Type}, {"Beat", Int64.Type}, {"District", Int64.Type}, {"Community Area", Int64.Type}, {"Latitude", type number}, {"Longitude", type number}, {"Hour", Int64.Type}, {"Month", Int64.Type}, {"DayOfWeek", type text}, {"Timeframe", type text}, {"YearMonth", type text}, {"Date", type datetime}}, "en-US"),
					AddDay = Table.AddColumn(Typed, "DayNum", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type)
				in
					AddDay

	annotation PBI_ResultType = Table

