table Crimes
	lineageTag: c08f57e2-636e-43dd-ad54-e1504bbcf3cb

	measure 'Total Incidents' = COUNTROWS(Crimes)
		formatString: #,0
		lineageTag: c58d7b3d-f968-472d-a949-8d7b40e0631a

	measure Arrests = CALCULATE(COUNTROWS(Crimes), Crimes[Arrest] = 1)
		formatString: #,0
		lineageTag: 781ae9fa-cac5-4b1a-8a35-7e73e90cedaf

	measure 'Arrest Rate' = DIVIDE([Arrests], [Total Incidents])
		formatString: 0.0%
		lineageTag: 83acd117-ec7c-4643-9260-269793a11665

	measure 'Domestic Share' = DIVIDE(CALCULATE(COUNTROWS(Crimes), Crimes[Domestic] = 1), [Total Incidents])
		formatString: 0.0%
		lineageTag: 9df5cc89-26d9-4d7e-83cc-6619f5671826

	measure 'Battery & Assault Incidents' = CALCULATE(COUNTROWS(Crimes), Crimes[Primary Type] IN {"BATTERY", "ASSAULT"})
		formatString: #,0
		lineageTag: 641db846-4518-4b5a-805c-2c6b8b5f6bc6

	column ID
		dataType: int64
		lineageTag: a355ad6a-f7f0-4492-944d-9d560e13a14b
		summarizeBy: none
		sourceColumn: ID

	column 'Primary Type'
		dataType: string
		lineageTag: 00152421-5166-40ae-925e-323f7abc06e7
		summarizeBy: none
		sourceColumn: Primary Type

	column DescGroup
