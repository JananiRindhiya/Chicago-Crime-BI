	column 'Predicted Label'
		dataType: string
		lineageTag: a7b79063-cee6-4d13-90cf-c59c22a155be
		summarizeBy: none
		sourceColumn: Predicted Label

	partition ConfusionMatrices = m
		mode: import
		source =
				let
					Folder = Text.TrimEnd(Text.Replace(Text.Trim(DataFolder), """", ""), "\"),
					Source = Csv.Document(File.Contents(Folder & "\confusion_matrices.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"Model", "FeatureSet", "Training", "Actual", "Predicted", "Count"}),
					Typed = Table.TransformColumnTypes(Selected, {{"Model", type text}, {"FeatureSet", type text}, {"Training", type text}, {"Actual", Int64.Type}, {"Predicted", Int64.Type}, {"Count", Int64.Type}}, "en-US"),
					AddLabel = Table.AddColumn(Typed, "Label", each [Model] & " | " & [FeatureSet] & " | " & [Training], type text),
					AddCell = Table.AddColumn(AddLabel, "Cell", each if [Actual]=0 and [Predicted]=0 then "TN" else if [Actual]=0 then "FP" else if [Predicted]=0 then "FN" else "TP", type text),
					AddAL = Table.AddColumn(AddCell, "Actual Label", each if [Actual]=1 then "Actual: Arrest" else "Actual: No arrest", type text),
					AddPL = Table.AddColumn(AddAL, "Predicted Label", each if [Predicted]=1 then "Pred: Arrest" else "Pred: No arrest", type text)
				in
					AddPL

	annotation PBI_ResultType = Table

